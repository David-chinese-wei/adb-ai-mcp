# 全部为可选项：不填时会自动从 ANDROID_HOME / 常见安装目录 / PATH 探测
# 复制为 .env 后按需修改（注意：MCP 客户端里要配在 mcpServers 的 env 字段，本文件仅供本地调试参考）

# adb 可执行文件绝对路径
ADB_EXE=
# scrcpy 可执行文件绝对路径
SCRCPY_EXE=
# Android SDK 根目录（用于探测 platform-tools/adb）
ANDROID_HOME=
# 默认设备序列号（多设备时省去每次指定）
ADB_SERIAL=
# 截图 / 录屏输出目录，默认项目下 outputs/
ADB_MCP_OUT_DIR=
# 设为 1 时输出调试日志到 stderr
ADB_MCP_DEBUG=0
